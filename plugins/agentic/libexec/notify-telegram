#!/usr/bin/env bash
# Send pipeline notifications to Telegram.
#
#   notify-telegram "text"          send a message (no-op if not configured)
#   notify-telegram --setup TOKEN   after you sent /start to the bot: find your chat id,
#                                   save credentials, send a test message
#
# Credentials (shared by all projects, never in git): ~/.config/agentic/telegram.env
#   TELEGRAM_BOT_TOKEN=123456:ABC…
#   TELEGRAM_CHAT_ID=123456789
set -euo pipefail

ENV_FILE=${AGENTIC_TELEGRAM_ENV:-$HOME/.config/agentic/telegram.env}
api() { curl -fsS --max-time 15 "https://api.telegram.org/bot$1/$2" "${@:3}"; }

if [[ ${1:-} == --setup ]]; then
  token=${2:?usage: notify-telegram --setup <bot token from @BotFather>}
  chat=$(api "$token" getUpdates | jq -r '[.result[] | (.message // .my_chat_member).chat.id] | last // empty')
  [[ -n $chat ]] || { echo "No chats yet — open your bot in Telegram, press Start (or send /start), then rerun." >&2; exit 1; }
  mkdir -p "$(dirname "$ENV_FILE")"
  (umask 077 && printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_CHAT_ID=%s\n' "$token" "$chat" >"$ENV_FILE")
  "$0" "✅ agentic pipeline: Telegram notifications are set up on $(hostname)"
  echo "saved $ENV_FILE (chat $chat), test message sent"
  exit 0
fi

[[ -f $ENV_FILE ]] || exit 0   # not configured → silently skip
# shellcheck source=/dev/null
source "$ENV_FILE"
text=${1:-$(cat)}
# Telegram rejects the whole message over invalid UTF-8 — text cut mid-letter, e.g. by ${…:0:N},
# which counts bytes outside a UTF-8 locale (cron, systemd). Drop the broken bytes instead;
# iconv -c exits 1 when it drops any.
text=$(printf '%s' "${text:0:4000}" | iconv -c -f utf-8 -t utf-8 2>/dev/null) || true
api "$TELEGRAM_BOT_TOKEN" sendMessage \
  --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
  --data-urlencode "text=$text" \
  --data-urlencode "disable_web_page_preview=true" >/dev/null
